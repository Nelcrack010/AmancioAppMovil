# Copia este archivo como .env.local (no se sube a Git) y deja UNA dirección de la API.
# Después de cambiarlo, reinicia Expo con: npx expo start -c --go
# (Guía completa en el README: "Cómo ejecutar y probar todo en local".)

# A. Celular por CABLE USB (antes: adb reverse tcp:8081 tcp:8081 y adb reverse tcp:5000 tcp:5000)
EXPO_PUBLIC_API_URL=http://localhost:5000

# B. Celular por WiFi: la IP de tu PC en la red (verla con "ipconfig"), NO 127.0.0.1.
# EXPO_PUBLIC_API_URL=http://192.168.18.64:5000

# C. Servidor del equipo en Oracle (valor por defecto si no creas .env.local):
# EXPO_PUBLIC_API_URL=https://146.181.54.237
