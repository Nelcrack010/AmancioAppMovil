# Copia este archivo como .env.local (no se sube a Git) y elige UNA dirección de la API.
# Después de cambiarlo, reinicia Expo con: npx expo start -c

# Backend en tu PC (python run.py). Desde el celular usa la IP de tu PC en la red WiFi,
# NO 127.0.0.1 (en el celular, 127.0.0.1 es el propio celular). Ver la IP con "ipconfig".
EXPO_PUBLIC_API_URL=http://192.168.1.50:5000

# Servidor del equipo (valor por defecto si no defines nada):
# EXPO_PUBLIC_API_URL=https://146.181.54.237
